3\u0437\u0431\u0435\u043a\u0438\u0441\u0442\u0430\u043d\u0430 \u043c\u043e\u0433\u0443\u0442 \u0432\u044b\u0438\u0433\u0440\u0430\u0442\u044c \u043f\u0440\u0438\u0437\u044b.\r\n\r\nMusobaqada har qanday ishtirokchi qatnasha oladi, sovg'alar faqat O'zbekiston fuqarolari uchun beriladi.","externalWebsite":null},{"id":"UzbekistanOpen2017","name":"Uzbekistan Open 2017","city":"Tashkent","country":"UZ","date":{"from":"2017-10-14","till":"2017-10-14","numberOfDays":1},"isCanceled":false,"events":["222","333","333bf","444","555","pyram","skewb"],"wcaDelegate":"[{Ron van Bruchem}{mailto:rbruchem@worldcubeassociation.org}]","organiser":"[{Hanneke Rijks}{mailto:hannekerijks@gmail.com}] [{Ravshanbek Abdullaev}{mailto:roshennn97@gmail.com}] [{Ron van Bruchem}{mailto:rbruchem@worldcubeassociation.org}]","venue":{"name":"[Westminster International University](http:\/\/www.wiut.uz\/)","address":"12 Istiqbol Street, Tashkent 100047, Uzbekistan","details":"Sports Hall","coordinates":{"latitude":41.307027,"longitude":69.282893}},"information":"Registration is full now. You can still register, but you will be placed on a waiting list and you can only compete if other people cancel. So your chances are small.\r\n\r\n==================\r\n\r\nThis is the first WCA competition in Uzbekistan. We hope after this competition many more will follow.\r\n\r\nAround 1-2 weeks before the competition you will receive an email to confirm your participation. Please make sure to check your mailbox and spam box around that time. If you do not confirm, then you will removed from the list of competitors.\r\n\r\nYou can pay the registration fee on-site in the venue.\r\n\r\n==========\r\n\r\n\u042d\u0442\u043e \u043f\u0435\u0440\u0432\u044b\u0435 \u0441\u043e\u0440\u0435\u0432\u043d\u043e\u0432\u0430\u043d\u0438\u044f WCA \u0432 \u0423\u0437\u0431\u0435\u043a\u0438\u0441\u0442\u0430\u043d\u0435. \u041c\u044b \u043d\u0430\u0434\u0435\u0435\u043c\u0441\u044f, \u0447\u0442\u043e \u043f\u043e\u0441\u043b\u0435 \u044d\u0442\u043e\u0433\u043e \u0441\u043e\u0440\u0435\u0432\u043d\u043e\u0432\u0430\u043d\u0438\u044f \u043f\u043e\u0441\u043b\u0435\u0434\u0443\u044e\u0442 \u043c\u043d\u043e\u0433\u043e \u0434\u0440\u0443\u0433\u0438\u0445.\r\n\r\n\u041f\u0440\u0438\u043c\u0435\u0440\u043d\u043e \u0437\u0430 1-2 \u043d\u0435\u0434\u0435\u043b\u0438 \u0434\u043e \u043d\u0430\u0447\u0430\u043b\u0430 \u0441\u043e\u0440\u0435\u0432\u043d\u043e\u0432\u0430\u043d\u0438\u044f \u0432\u044b \u043f\u043e\u043b\u0443\u0447\u0438\u0442\u0435 \u044d\u043b\u0435\u043a\u0442\u0440\u043e\u043d\u043d\u043e\u0435 \u043f\u0438\u0441\u044c\u043c\u043e, \u0447\u0442\u043e\u0431\u044b \u043f\u043e\u0434\u0442\u0432\u0435\u0440\u0434\u0438\u0442\u044c \u0441\u0432\u043e\u0435 \u0443\u0447\u0430\u0441\u0442\u0438\u0435. \u041e\u0431\u044f\u0437\u0430\u0442\u0435\u043b\u044c\u043d\u043e \u043f\u0440\u043e\u0432\u0435\u0440\u044f\u0439\u0442\u0435 \u0441\u0432\u043e\u0439 \u043f\u043e\u0447\u0442\u043e\u0432\u044b\u0439 \u044f\u0449\u0438\u043a \u0438 \u0441\u043f\u0430\u043c \u0437\u0430 1-2 \u043d\u0435\u0434\u0435\u043b\u0438 \u0434\u043e \u0441\u043e\u0440\u0435\u0432\u043d\u043e\u0432\u0430\u043d\u0438\u0439. \u0415\u0441\u043b\u0438 \u0443\u0447\u0430\u0441\u0442\u0438\u0435 \u043d\u0435 \u0431\u0443\u0434\u0435\u0442 \u043f\u043e\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043d\u043e \u0442\u043e \u0443\u0447\u0430\u0441\u0442\u043d\u0438\u043a \u0431\u0443\u0434\u0435\u0442 \u0443\u0434\u0430\u043b\u0435\u043d \u0438\u0437 \u0441\u043f\u0438\u0441\u043a\u0430 \u043a\u043e\u043d\u043a\u0443\u0440\u0441\u0430\u043d\u0442\u043e\u0432.\r\n\r\n\u0412\u044b \u043c\u043e\u0436\u0435\u0442\u0435 \u043e\u043f\u043b\u0430\u0442\u0438\u0442\u044c \u0440\u0435\u0433\u0438\u0441\u0442\u0440\u0430\u0446\u0438\u043e\u043d\u043d\u044b\u0439 \u0441\u0431\u043e\u0440 \u043d\u0430 \u043c\u0435\u0441\u0442\u0435 \u0432 \u043c\u0435\u0441\u0442\u0435 \u043f\u0440\u043e\u0432\u0435\u0434\u0435\u043d\u0438\u044f.\r\n\r\n==========\r\n\r\nBu Uzbekistondagi birinchi WCA musobaqalari. Umid qilamiz-ki, bu musobaqadan keyin, boshqa koplab musobaqlar amalga oshiriladi.\r\n\r\nIshtirokingizni tasdiqlash uchun musobaqadan 1-2 hafta oldin elektron pochta olasiz. Musoboqadan 1-2 hafta oldin pochtangizni va spam papkasini tekshirib turing. Ishtirokchi qatnashishini tasdiqlamasa, qatnashuvchilar ro'yxatidan o'chiriladi.\r\n\r\nRo'yhatga olish narxini musbaqa bo'ladigan joyda to'lashingiz mumkin.","externalWebsite":null}]}